# Machine-specific settings for `docker compose`. Copy to `.env` and change what you need;
# every setting is optional.

# The model the agent uses: an Ollama tag, or a GGUF repo on Hugging Face as
# hf.co/<user>/<repo>:<quantisation>. Pulled on `docker compose up`.
MODEL=gemma4:e4b

# Whether the model thinks before it answers. Set false for a model that can't think.
THINKING=true

# The model's sampling temperature. 0 keeps answers repeatable; a thinking model that loops
# at 0 (Qwen) needs its recommended value, such as 0.6.
TEMPERATURE=0

# The model's context window in tokens. Our prompts are under 1k; a bigger window uses more
# VRAM and loads more slowly.
CONTEXT_LENGTH=8192

# The UI's port on this machine, if 3000 is taken. The browser must still use port 3000,
# so tunnel to it: ssh -N -L 3000:localhost:<UI_PORT> <host>
UI_PORT=3000

# MLflow's port on this machine, if 5000 is taken. Tunnel to it like the UI.
MLFLOW_PORT=5000

# Where the UI listens. Keep 127.0.0.1 and use an SSH tunnel; 0.0.0.0 exposes it to the network.
BIND_ADDRESS=127.0.0.1
